# ==============================================================================
# AI Adaptive Coach v7.0 - Environment Configuration Blueprint (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI Adaptive Coach"
APP_ENV=production                       # choices: development, staging, production
APP_VERSION=7.0.0
DEBUG=false
LOG_LEVEL=INFO                           # choices: DEBUG, INFO, WARNING, ERROR, CRITICAL

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_HOSTS=["api.aicoach.ru", "localhost", "127.0.0.1"]
CORS_ORIGINS=["https://aicoach.ru", "https://app.aicoach.ru", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION KEYS (152-FZ COMPLIANCE)
# ------------------------------------------------------------------------------
# Secret Key for JWT Token Generation (Generate via `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Master Key for Personal & Telemetry Data Encryption at Rest (Base64 32-bytes)
# Generate via: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY_BASE64=change_this_to_base64_encoded_32_byte_key_for_aes256_gcm==

# ------------------------------------------------------------------------------
# 3. POSTGRESQL 16 DATABASE CONFIGURATION (AsyncPG)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=ai_coach_user
POSTGRES_PASSWORD=secure_postgres_password_change_me
POSTGRES_DB=ai_coach_db
POSTGRES_SSL_MODE=prefer                 # disable, allow, prefer, require

# Full Async SQLAlchemy Connection URL
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://ai_coach_user:secure_postgres_password_change_me@db:5432/ai_coach_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. REDIS 7 CACHE & BROKER CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_change_me
REDIS_DB=0
REDIS_URL=redis://:secure_redis_password_change_me@redis:6379/0

# ------------------------------------------------------------------------------
# 5. RUSSIAN CLOUD PROVIDERS (SELECTEL / YANDEX CLOUD 152-FZ COMPLIANT STACK)
# ------------------------------------------------------------------------------
CLOUD_PROVIDER=selectel                  # choices: selectel, yandex_cloud, local

# Selectel Cloud Platform Settings
SELECTEL_ACCOUNT_ID=123456
SELECTEL_PROJECT_ID=selectel_project_uuid
SELECTEL_REGION=ru-1                     # ru-1 (Moscow), ru-2 (Saint Petersburg)
SELECTEL_S3_ENDPOINT=https://s3.selectel.ru
SELECTEL_S3_BUCKET_NAME=ai-coach-telemetry-storage
SELECTEL_S3_ACCESS_KEY=selectel_access_key_id
SELECTEL_S3_SECRET_KEY=selectel_secret_access_key

# Yandex Cloud (YC) Platform Settings (Alternative / Failover)
YC_FOLDER_ID=b1g...
YC_SA_JSON_KEY_FILE=/etc/aicoach/yc-sa-key.json
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_BUCKET_NAME=ai-coach-yc-telemetry
YC_KMS_KEY_ID=yc.kms.keys.ab123456789...

# ------------------------------------------------------------------------------
# 6. AI ENGINE INTEGRATIONS & LLM BACKBONE
# ------------------------------------------------------------------------------
AI_ENGINE_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
AI_SAFETY_FALLBACK_MODE=true

# ------------------------------------------------------------------------------
# 7. TELEMETRY, SENTRY & MONITORING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 8. TELEGRAM BOT V3 & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather_here
TELEGRAM_WEBHOOK_URL=https://your-domain-or-vps-ip/api/v1/telegram/webhook
TELEGRAM_WEBAPP_URL=https://your-domain-or-vps-ip/pwa

# ------------------------------------------------------------------------------
# 9. STRAVA API INTEGRATION (OAUTH 2.0 & WEBHOOKS)
# ------------------------------------------------------------------------------
STRAVA_CLIENT_ID=your_strava_app_client_id_here
STRAVA_CLIENT_SECRET=your_strava_app_client_secret_here
STRAVA_REDIRECT_URI=https://your-domain-or-vps-ip/api/v1/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token_here
STRAVA_FETCH_DELAY_SECONDS=3600


