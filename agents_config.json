{
  "$schema": "https://ai-adaptive-coach.ru/schemas/agents-config/v2.0.json",
  "_comment": "agents_config.json — Полная конфигурация роевой системы агентов. Читается orchestrator.py. Обновляется при изменении структуры агентов.",
  "_version": "2.0.0",
  "_updated": "2026-08-01",
  "_phase": "ЭТАП 2 рефакторинга: 3-слойная иерархическая матричная архитектура",

  "orchestration": {
    "engine": "orchestrator/orchestrator.py",
    "routing_rules": "orchestrator/routing_rules.yaml",
    "blackboard": {
      "adapter": "filesystem",
      "adapter_class": "orchestrator.blackboard_adapter.FileSystemAdapter",
      "tasks_path": "blackboard/tasks",
      "interrupts_path": "blackboard/interrupts",
      "archive_path": "blackboard/archive",
      "index_file": "blackboard/index.json",
      "future_adapters": ["RedisAdapter", "PostgreSQLAdapter"]
    },
    "micro_communication": {
      "lead_worker_direct_calls": true,
      "record_micro_to_blackboard": false,
      "record_final_outcomes_only": true,
      "rationale": "Saves tokens; only terminal states written to Blackboard"
    },
    "task_id_format": "TASK-{YYYYMMDD}-{SEQ:04d}",
    "interrupt_id_format": "INTERRUPT_REQ_{task_id}.json"
  },

  "arbitration": {
    "priority_order": [
      "security_policy_keeper",
      "legal_compliance_policy_keeper",
      "finance_budget_policy_keeper",
      "product_ux_policy_keeper"
    ],
    "rules": {
      "p1_reject": "IMMEDIATE_BLOCK — task → BLOCKED, no further arbitration",
      "p2_reject": "FEATURE_BLOCK — task → BLOCKED, Human Override required",
      "p3_reject": "SCOPE_REDUCE — reduce task scope to fit budget, re-route to Team Lead",
      "p4_reject": "ADAPT_REQUEST — Team Lead proposes UX alternative within 1 attempt"
    }
  },

  "cold_start_protocol": {
    "mode": "PASS_THROUGH_WITH_WARNING",
    "condition": "policy_store_empty OR first_task_for_agent",
    "action": "pass_task + generate_draft_rules_from_context",
    "blackboard_log_level": "WARNING"
  },

  "circuit_breaker": {
    "worker_max_attempts": 3,
    "team_lead_max_reconfig_attempts": 2,
    "escalation_sla_hours": 24,
    "trigger": "attempts_exhausted OR p1_hard_block OR sla_breach"
  },

  "agents": {

    "core": [
      {
        "id": "orchestrator_engine",
        "role": "Deterministic Orchestration State Machine",
        "entrypoint": "orchestrator/orchestrator.py:OrchestratorEngine",
        "always_active": true,
        "permissions": {
          "blackboard_read": ["ALL"],
          "blackboard_write": ["status", "status_history", "layer_routing", "arbitration"],
          "can_block_task": false,
          "can_trigger_escalation": true,
          "can_approve_gate": []
        },
        "triggers": ["blackboard_poll_interval_seconds: 10", "on_task_created", "on_status_changed"]
      },
      {
        "id": "blackboard_manager",
        "role": "Task Artifact Manager & Blackboard Index",
        "entrypoint": "orchestrator/blackboard_adapter.py:FileSystemAdapter",
        "always_active": true,
        "permissions": {
          "blackboard_read": ["ALL"],
          "blackboard_write": ["ALL"],
          "can_block_task": false,
          "can_trigger_escalation": false,
          "can_approve_gate": []
        },
        "triggers": ["on_task_write_request", "on_index_update_request"]
      },
      {
        "id": "human_escalation_handler",
        "role": "Human-in-the-Loop Interface & Circuit Breaker",
        "always_active": false,
        "permissions": {
          "blackboard_read": ["BLOCKED", "IN_PROGRESS"],
          "blackboard_write": ["human_escalation", "status"],
          "can_block_task": false,
          "can_trigger_escalation": true,
          "can_approve_gate": []
        },
        "triggers": ["on_circuit_breaker_trip", "on_p1_hard_block", "on_sla_breach"]
      }
    ],

    "layer_1_policy": [
      {
        "id": "security_policy_keeper",
        "layer": 1,
        "priority": 1,
        "role": "Security & Data Privacy Policy Keeper",
        "merged_from": ["cybersecurity_penetration_tester", "data_privacy_dpo"],
        "permissions": {
          "blackboard_read": ["BACKLOG", "ENRICHING", "CODE_REVIEW", "COMPLIANCE_REVIEW"],
          "blackboard_write": ["policy_gates.security", "arbitration"],
          "can_block_task": true,
          "can_trigger_escalation": true,
          "can_approve_gate": ["security"],
          "file_access": {
            "read": ["app/core/security.py", "app/core/config.py", "app/core/rate_limiter.py", "app/**/*.py"],
            "write": ["docs/security/"]
          }
        },
        "triggers": ["on_task_enters_ENRICHING", "on_task_enters_COMPLIANCE_REVIEW"],
        "cold_start": "PASS_THROUGH_WITH_WARNING"
